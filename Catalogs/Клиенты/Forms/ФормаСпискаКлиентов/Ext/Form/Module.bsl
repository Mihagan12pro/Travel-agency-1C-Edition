
&НаСервере
Процедура ИмпортироватьКлиентовИзExcelНаСервере(АдресХранилища, ИсходноеИмяФайла)
	
	 ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
    Расширение = "xlsx";
    Если Найти(НРег(ИсходноеИмяФайла), ".xls") > 0 И Найти(НРег(ИсходноеИмяФайла), ".xlsx") = 0 Тогда
        Расширение = "xls";
    КонецЕсли;
    
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
    ДвоичныеДанные.Записать(ИмяВременногоФайла);
    
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Прочитать(ИмяВременногоФайла);
    Высота = ТабДок.ВысотаТаблицы;
    
    Для Стр = 2 По Высота Цикл
        
        ФИО               = СокрЛП(ТабДок.Область(Стр, 1).Текст); // A
        ПолТекст          = СокрЛП(ТабДок.Область(Стр, 2).Текст); // B
        ДатаРожденияТекст = СокрЛП(ТабДок.Область(Стр, 3).Текст); // C
        Серия             = СокрЛП(ТабДок.Область(Стр, 5).Текст); // E
        Номер             = СокрЛП(ТабДок.Область(Стр, 6).Текст); // F
        ДатаВыдачиТекст   = СокрЛП(ТабДок.Область(Стр, 7).Текст); // G
        ДатаОкончанияТекст= СокрЛП(ТабДок.Область(Стр, 8).Текст); // H
        ОрганВыдачиТекст  = СокрЛП(ТабДок.Область(Стр, 9).Текст); // I
        
        Если ПустаяСтрока(ФИО) Тогда
            Продолжить; 
        КонецЕсли;
        
        ДатаРождения  = ОбщиеСерверныеФункции.ПреобразоватьСтрокуВДату(ДатаРожденияТекст);
        ДатаВыдачи    = ОбщиеСерверныеФункции.ПреобразоватьСтрокуВДату(ДатаВыдачиТекст);
        ДатаОкончания = ОбщиеСерверныеФункции.ПреобразоватьСтрокуВДату(ДатаОкончанияТекст);
        
        Фамилия = ""; Имя = ""; Отчество = "";
        ЧастиФИО = СтрРазделить(ФИО, " ", Ложь);
        Если ЧастиФИО.Количество() > 0 Тогда Фамилия = ЧастиФИО[0]; КонецЕсли;
        Если ЧастиФИО.Количество() > 1 Тогда Имя = ЧастиФИО[1]; КонецЕсли;
        Если ЧастиФИО.Количество() > 2 Тогда Отчество = ЧастиФИО[2]; КонецЕсли;
        
        ПолЗначение = Неопределено;
        Если ВРег(ПолТекст) = "М" Тогда
            ПолЗначение = Перечисления.Пол.Мужской; 
        ИначеЕсли ВРег(ПолТекст) = "Ж" Тогда
            ПолЗначение = Перечисления.Пол.Женский;
        КонецЕсли;
        
        ОрганСсылка = Справочники.ОрганыВыдачиДокументов.НайтиПоНаименованию(ОрганВыдачиТекст, Истина);
        Если ОрганСсылка.Пустая() Тогда
            НовОрган = Справочники.ОрганыВыдачиДокументов.СоздатьЭлемент();
            НовОрган.Наименование = ОрганВыдачиТекст;
            НовОрган.Записать();
            ОрганСсылка = НовОрган.Ссылка;
        КонецЕсли;
        
        НовПаспорт = Справочники.ПаспортныеДанные.СоздатьЭлемент();
        НовПаспорт.Наименование = "Паспорт " + Серия + " " + Номер; 
		НовПаспорт.Серия = Серия;
        НовПаспорт.Номер = Номер;
        НовПаспорт.СерияНомер = Серия + " " + Номер;
		НовПаспорт.ДатаВыдачи = ДатаВыдачи;
        НовПаспорт.ДатаОкончанияДействия = ДатаОкончания;
        НовПаспорт.ОрганВыдавшийДокумент = ОрганСсылка;
        НовПаспорт.Записать();
        
        НовКлиент = Справочники.Клиенты.СоздатьЭлемент();
        НовКлиент.Наименование = Фамилия;
        НовКлиент.ФИО = ФИО;
        НовКлиент.Фамилия = Фамилия;
        НовКлиент.Имя = Имя;
        НовКлиент.Отчество = Отчество;
        НовКлиент.ДатаРождения = ДатаРождения;
        
        Если ПолЗначение <> Неопределено Тогда
            НовКлиент.Пол = ПолЗначение;
        КонецЕсли;
        
        Попытка
            НовКлиент.СтатусКлиента = ПредопределенноеЗначение("Перечисление.СтатусКлиента.Обычный");
        Исключение
            Попытка
                НовКлиент.СтатусКлиента = "Обычный";
            Исключение
            КонецПопытки;
        КонецПопытки;
        
        НовКлиент.ПаспортныеДанные = НовПаспорт.Ссылка;
        
        НовКлиент.Записать();
        
    КонецЦикла;
    
    УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИмпортироватьКлиентовИзExcel(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы Excel|*.xlsx;*.xls";
    
    РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
    
    Если РезультатВыбора = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
    
    ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,ПолноеИмяФайла);
    
    Если ОписаниеФайла = Неопределено Тогда
        Сообщить("Не удалось поместить файл на сервер.");
        Возврат;
    КонецЕсли;
    
    АдресХранилища = ОписаниеФайла.Адрес;
    
    ИмпортироватьКлиентовИзExcelНаСервере(АдресХранилища, ПолноеИмяФайла);
    
    Сообщить("Клиенты успешно загружены!");
	
КонецПроцедуры
