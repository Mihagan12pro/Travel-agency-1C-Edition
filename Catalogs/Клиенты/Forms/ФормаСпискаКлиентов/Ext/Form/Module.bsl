
&НаСервере
Процедура ИмпортироватьИзExcelНаСервере(АдресВХранилище, ИсходноеИмяФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	    
	Расширение = "xlsx";
	Если Найти(НРег(ИсходноеИмяФайла), ".xls") > 0 И Найти(НРег(ИсходноеИмяФайла), ".xlsx") = 0 Тогда
		Расширение = "xls";
	КонецЕсли;
	            
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ИмяВременногоФайла);
	
	Высота = ТабДок.ВысотаТаблицы;
	
	Для Стр = 2 По Высота Цикл
        ФИО = СокрЛП(ТабДок.Область(Стр, 1).Текст);
        Если ПустаяСтрока(ФИО) Тогда
            Продолжить; 
        КонецЕсли;
        
        МассивСловФИО = СтрРазделить(ФИО, " ");
        Фамилия = ?(МассивСловФИО.Количество() > 0, МассивСловФИО[0], ФИО);
        
        КлиентСсылка = Справочники.Клиенты.НайтиПоНаименованию(Фамилия);
        Если КлиентСсылка.Пустая() Тогда
            НовКлиент = Справочники.Клиенты.СоздатьЭлемент();
        Иначе
            НовКлиент = КлиентСсылка.ПолучитьОбъект();
        КонецЕсли;
        
        НовКлиент.Наименование = Фамилия;
        НовКлиент.ФИО = ФИО;
        
        ПолСимвол = СокрЛП(ТабДок.Область(Стр, 2).Текст);
        Если ПолСимвол = "М" Тогда
            НовКлиент.Пол = Перечисления.Пол.Мужской;
        ИначеЕсли ПолСимвол = "Ж" Тогда
            НовКлиент.Пол = Перечисления.Пол.Женский;
        КонецЕсли;

        // --- Дата рождения ---
        ДатаРождения = Дата(1, 1, 1);
        Если ОбщиеСерверныеФункции.СтрокаВДату(ТабДок.Область(Стр, 3).Текст, ДатаРождения) Тогда
            НовКлиент.ДатаРождения = ДатаРождения;
        КонецЕсли; // Закрываем условие даты рождения здесь
            
        // --- Паспортные данные (ВЫНЕСЕНО НАРУЖУ) ---
        Серия = СокрЛП(ТабДок.Область(Стр, 5).Текст);
        Номер = СокрЛП(ТабДок.Область(Стр, 6).Текст);

        Если Не ПустаяСтрока(Серия) И Не ПустаяСтрока(Номер) Тогда
            Паспорт = Справочники.ПаспортныеДанные.СоздатьЭлемент();
            Паспорт.Серия = Серия;
            Паспорт.Номер = Номер;

            ДатаВыдачи = Дата(1, 1, 1);
            ДатаОкончания = Дата(1, 1, 1);
            
            Если ОбщиеСерверныеФункции.СтрокаВДату(ТабДок.Область(Стр, 7).Текст, ДатаВыдачи) Тогда
                Паспорт.ДатаВыдачи = ДатаВыдачи;
            КонецЕсли;
            
            Если ОбщиеСерверныеФункции.СтрокаВДату(ТабДок.Область(Стр, 8).Текст, ДатаОкончания) Тогда
                Паспорт.ДатаОкончанияДействия = ДатаОкончания;
            КонецЕсли;

            ОрганНаименование = СокрЛП(ТабДок.Область(Стр, 9).Текст);
            Если Не ПустаяСтрока(ОрганНаименование) Тогда
                Орган = Справочники.ОрганыВыдачиДокументов.НайтиПоНаименованию(ОрганНаименование);
                Если Орган.Пустая() Тогда
                    Орган = Справочники.ОрганыВыдачиДокументов.СоздатьЭлемент();
                    Орган.Наименование = ОрганНаименование;
                    Орган.Записать();
                КонецЕсли;
                Паспорт.ОрганВыдавшийДокумент = Орган;
            КонецЕсли;

            Паспорт.Записать();
            НовКлиент.ПаспортныеДанные = Паспорт;
        КонецЕсли;

        // --- Статус клиента ---
        // В оригинале была опечатка: СтатусСлиента. Исправлено на СтатусКлиента
        Если НовКлиент.СтатусКлиента.Пустая() Тогда
            НовКлиент.СтатусКлиента = Перечисления.СтатусКлиента.Обычный;
        КонецЕсли;

        НовКлиент.Записать();  
                                
    КонецЦикла;			
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИмпортироватьИзExcel(Команда)
	
    Результат = Ждать ОбщиеАсинхФункции.ВыбратьФайл("Файлы Excel|*.xlsx;*.xls");
	
	Если Результат <> "-" Тогда
	
		ИмпортироватьИзExcelНаСервере(Результат.АдресХранилища, Результат.ПолноеИмяФайла);
    	Сообщить("Клиенты успешно загружены!");
		
	КонецЕсли;
	
КонецПроцедуры
