
&НаСервере
Процедура ИмпортироватьСотрудниковИзExcelНаСервере(АдресХранилища, ИсходноеИмяФайла)
	
	 ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
    Расширение = "xlsx";
    Если Найти(НРег(ИсходноеИмяФайла), ".xls") > 0 И Найти(НРег(ИсходноеИмяФайла), ".xlsx") = 0 Тогда
        Расширение = "xls";
    КонецЕсли;
    
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
    ДвоичныеДанные.Записать(ИмяВременногоФайла);
    
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Прочитать(ИмяВременногоФайла);
    Высота = ТабДок.ВысотаТаблицы;
    
    // Данные начинаются с 3-й строки (1-я пустая, 2-я - заголовки)
    Для Стр = 3 По Высота Цикл
        
        // Колонку A (Организация) пропускаем
        ДолжностьТекст = СокрЛП(ТабДок.Область(Стр, 2).Текст); // B
        ИмяКраткое     = СокрЛП(ТабДок.Область(Стр, 3).Текст); // C (Наименование)
        ФИО            = СокрЛП(ТабДок.Область(Стр, 4).Текст); // D
        ДатаТекст      = СокрЛП(ТабДок.Область(Стр, 5).Текст); // E
        
        Если ПустаяСтрока(ИмяКраткое) И ПустаяСтрока(ФИО) Тогда
            Продолжить; 
        КонецЕсли;
        
        // 1. Разбираем ФИО на Фамилию, Имя и Отчество
        Фамилия = ""; Имя = ""; Отчество = "";
        ЧастиФИО = СтрРазделить(ФИО, " ", Ложь); // Ложь - игнорировать пустые подстроки
        Если ЧастиФИО.Количество() > 0 Тогда
            Фамилия = ЧастиФИО[0];
        КонецЕсли;
        Если ЧастиФИО.Количество() > 1 Тогда
            Имя = ЧастиФИО[1];
        КонецЕсли;
        Если ЧастиФИО.Количество() > 2 Тогда
            Отчество = ЧастиФИО[2];
        КонецЕсли;
        
        // 2. Определяем должность
        ДолжностьЗначение = Неопределено;
        Попытка
            ДолжностьЗначение = ПредопределенноеЗначение("Перечисление.Должности." + СтрЗаменить(ДолжностьТекст, " ", ""));
        Исключение
            // Если должности нет в перечислении, оставляем Неопределено
        КонецПопытки;
        
        // 3. Парсим дату рождения ЧЕРЕЗ ВАШ ОБЩИЙ МОДУЛЬ
        ДатаРождения = ОбщиеСерверныеФункции.ПреобразоватьСтрокуВДату(ДатаТекст);
        
        // 4. Ищем или создаем Сотрудника (поиск по Наименованию - инициалам)
        СотрудникСсылка = Справочники.Сотрудники.НайтиПоНаименованию(ИмяКраткое, Истина);
        Если СотрудникСсылка.Пустая() Тогда
            НовСотрудник = Справочники.Сотрудники.СоздатьЭлемент();
        Иначе
            НовСотрудник = СотрудникСсылка.ПолучитьОбъект();
        КонецЕсли;
        
        // Заполняем реквизиты
        НовСотрудник.Наименование = ИмяКраткое;
        НовСотрудник.ФИО = ФИО;
        НовСотрудник.Фамилия = Фамилия;
        НовСотрудник.Имя = Имя;
        НовСотрудник.Отчество = Отчество;
        НовСотрудник.ДатаРождения = ДатаРождения; // <--- ТЕПЕРЬ ЗАПИШЕТСЯ КОРРЕКТНО
        
        Если ДолжностьЗначение <> Неопределено Тогда
            НовСотрудник.Должность = ДолжностьЗначение;
        КонецЕсли;
        
        НовСотрудник.Записать();
        
    КонецЦикла;
    
    УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИмпортироватьСотрудниковИзExcel(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы Excel|*.xlsx;*.xls";
    
    // Ждем выбора файла и сохраняем результат
    РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
    
    // Проверяем, не нажал ли пользователь Отмену
    Если РезультатВыбора = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
    
    // Помещаем файл на сервер (если метод с Асинх не работает в вашей версии, используйте ПоместитьФайлНаСерверАсинх)
    ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,ПолноеИмяФайла);
    
    Если ОписаниеФайла = Неопределено Тогда
        Сообщить("Не удалось поместить файл на сервер.");
        Возврат;
    КонецЕсли;
    
    АдресХранилища = ОписаниеФайла.Адрес;
    
    ИмпортироватьСотрудниковИзExcelНаСервере(АдресХранилища, ПолноеИмяФайла);
    
    Сообщить("Сотрудники успешно загружены!");
	
КонецПроцедуры
