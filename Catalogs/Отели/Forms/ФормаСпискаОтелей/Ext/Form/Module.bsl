
&НаСервере
Процедура ИмпортироватьОтелиИзExcelНаСервере(АдресХранилища, ИсходноеИмяФайла)
	 ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
    Расширение = "xlsx";
    Если Найти(НРег(ИсходноеИмяФайла), ".xls") > 0 И Найти(НРег(ИсходноеИмяФайла), ".xlsx") = 0 Тогда
        Расширение = "xls";
    КонецЕсли;
    
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
    ДвоичныеДанные.Записать(ИмяВременногоФайла);
    
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Прочитать(ИмяВременногоФайла);
    Высота = ТабДок.ВысотаТаблицы;
    
    Для Стр = 2 По Высота Цикл
		
		ИмяСтраны  = СокрЛП(ТабДок.Область(Стр, 1).Текст); 
        ИмяГорода  = СокрЛП(ТабДок.Область(Стр, 2).Текст); 
        ИмяОтеля   = СокрЛП(ТабДок.Область(Стр, 3).Текст); 
        Категория  = СокрЛП(ТабДок.Область(Стр, 4).Текст); 
		АдресОтеля = СокрЛП(ТабДок.Область(Стр, 5).Текст); 
        
        Если ПустаяСтрока(ИмяОтеля) Или ПустаяСтрока(ИмяГорода) Тогда
            Продолжить; 
        КонецЕсли;
        
        СтранаСсылка = Справочники.Страны.НайтиПоНаименованию(ИмяСтраны, Истина);
        Если СтранаСсылка.Пустая() Тогда
            НовСтрана = Справочники.Страны.СоздатьЭлемент();
            НовСтрана.Наименование = ИмяСтраны;
            НовСтрана.Записать();
            СтранаСсылка = НовСтрана.Ссылка;
        КонецЕсли;
        
        ГородСсылка = Справочники.Города.НайтиПоНаименованию(ИмяГорода, Истина);
        Если ГородСсылка.Пустая() Тогда
            НовГород = Справочники.Города.СоздатьЭлемент();
            НовГород.Наименование = ИмяГорода;
            НовГород.Страна = СтранаСсылка; 
			НовГород.Записать();
            ГородСсылка = НовГород.Ссылка;
        КонецЕсли;
        
        ТипОтеляЗначение = Неопределено;
        Если Категория = "1" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.ОднаЗвезда;
        ИначеЕсли Категория = "2" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.ДвеЗвезды;
        ИначеЕсли Категория = "3" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.ТриЗвезды;
        ИначеЕсли Категория = "4" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.ЧетыреЗвезды;
        ИначеЕсли Категория = "5" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.ПятьЗвезд;
        ИначеЕсли ВРег(Категория) = "АПАРТАМЕНТЫ" Тогда
            ТипОтеляЗначение = Перечисления.ТипОтеля.Апартаменты;
        КонецЕсли;
        
        ОтельСсылка = Справочники.Отели.НайтиПоНаименованию(ИмяОтеля, Истина);
        Если ОтельСсылка.Пустая() Тогда
            НовОтель = Справочники.Отели.СоздатьЭлемент();
        Иначе
            НовОтель = ОтельСсылка.ПолучитьОбъект();
        КонецЕсли;
		
		НовОтель.Наименование = ИмяОтеля;
        НовОтель.Страна = СтранаСсылка; 
        НовОтель.Город = ГородСсылка;
        НовОтель.Адрес = АдресОтеля;
        
        Если ТипОтеляЗначение <> Неопределено Тогда
            НовОтель.Тип = ТипОтеляЗначение;
        КонецЕсли;
        
        НовОтель.Записать();
        
    КонецЦикла;
    
    УдалитьФайлы(ИмяВременногоФайла);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИмпортироватьОтелиИзExcel(Команда)
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы Excel|*.xlsx;*.xls";
    
    РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
    
    Если РезультатВыбора = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
    
    ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,ПолноеИмяФайла);
    
    АдресХранилища = ОписаниеФайла.Адрес;
    
    ИмпортироватьОтелиИзExcelНаСервере(АдресХранилища, ПолноеИмяФайла);
    
    Сообщить("Отели, города и страны успешно загружены!");
    
КонецПроцедуры