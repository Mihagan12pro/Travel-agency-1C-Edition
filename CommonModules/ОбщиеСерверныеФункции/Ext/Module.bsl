&НаСервере
Функция ПреобразоватьСтрокуВДату(СтрокаДаты)Экспорт
	ЧистаяСтрока = СокрЛП(СтрокаДаты);
	
	ЧистаяСтрока = СтрРазделить(ЧистаяСтрока, " ")[0];
	
	Если ПустаяСтрока(ЧистаяСтрока) Тогда 
		Возврат Дата('00010101'); 
	КонецЕсли;
	
	МассивДат = СтрРазделить(ЧистаяСтрока, ".");
	Если МассивДат.Количество() = 3 Тогда
		Попытка
			Возврат Дата(Число(МассивДат[2]), Число(МассивДат[1]), Число(МассивДат[0]));
		Исключение
			Возврат Дата('00010101');
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Возврат Дата(СтрокаДаты);
	Исключение
		Возврат Дата('00010101');
	КонецПопытки;
КонецФункции    