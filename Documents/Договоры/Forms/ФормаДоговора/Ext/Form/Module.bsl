&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Для Каждого ЭлементКоллекции Из Объект.УчастникиПоездки Цикл
		
		ПолеФИО = ОбщиеФункции.РазбитьСтрокуНаПодстроки(ЭлементКоллекции.ФИО);

		Если ПолеФИО.Количество() > 3 ИЛИ ПолеФИО.Количество() < 2 Тогда
			ОбщиеПроцедуры.НекорректноеФИО("Неполное ФИО!");
			Отказ = ИСТИНА;  
		КонецЕсли;
			
		Фамилия = ПолеФИО[0];
		Имя = ПолеФИО[1];
		Отчество = "-";
		
		Если ПолеФИО.Количество() = 3 Тогда
			Отчество = ПолеФИО[2];
		КонецЕсли;
		
		Если ОбщиеФункции.ЭтоКорректноеСлово(Имя) = Ложь ИЛИ ОбщиеФункции.ЭтоКорректноеСлово(Фамилия) = Ложь ИЛИ ОбщиеФункции.ЭтоКорректноеСлово(Отчество) = Ложь Тогда
			ОбщиеПроцедуры.НекорректноеФИО("В ФИО должна быть одна кириллица!");
			Отказ = ИСТИНА;
		КонецЕсли;     
		
	КонецЦикла;   
	
	Если Объект.НачалоПоездки >= Объект.ОкончаниеПоездки Тогда
		Сообщить("Начало поездки должно быть раньше конца поездки!");  
		Отказ = ИСТИНА;
	КонецЕсли; 
	
	Для Каждого ЭлементКоллекции Из Объект.МаршрутПоездки Цикл
		
		Если ЭлементКоллекции.ДатаНачала >= ЭлементКоллекции.ДатаОкончания Тогда
			Сообщить("Дата начала точки маршрута должна быть строго раньше даты окончания!");
			Отказ = ИСТИНА;
		КонецЕсли;
		
		Если ЭлементКоллекции.ДатаНачала < Объект.НачалоПоездки Тогда      
			Сообщить("Некорректная дата начала поездки или дата начала точки маршрута!");
			Отказ = ИСТИНА;
		КонецЕсли; 
		
		Если ЭлементКоллекции.ДатаОкончания > Объект.ОкончаниеПоездки Тогда      
			Сообщить("Некорректная дата окончания поездки или дата окончания точки маршрута!");
			Отказ = ИСТИНА;
		КонецЕсли;

	КонецЦикла;   
	 
	
КонецПроцедуры

