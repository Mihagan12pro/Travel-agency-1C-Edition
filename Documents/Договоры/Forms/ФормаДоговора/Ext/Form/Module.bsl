&НаКлиенте
Процедура ОбработкаВыбораСоглашения(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
        Возврат;
    КонецЕсли;
    
    ДанныеСоглашения = ПолучитьДанныеСоглашенияНаСервере(ВыбранноеЗначение);  
    Объект.Клиент = ДанныеСоглашения.Клиент;    
    Объект.СтранаПосещения = ДанныеСоглашения.Страна;
	Объект.Организация = ДанныеСоглашения.Организация;
	Объект.Агент = ДанныеСоглашения.Агент;
	
	Пока Объект.УчастникиПоездки.Количество() < ДанныеСоглашения.ЧислоУчастниковПоездки Цикл 
		Объект.УчастникиПоездки.Добавить();
	КонецЦикла;
	
	Пока Объект.УчастникиПоездки.Количество() > ДанныеСоглашения.ЧислоУчастниковПоездки Цикл
		Объект.УчастникиПоездки.Удалить(Объект.УчастникиПоездки.Количество() - 1);
	КонецЦикла;    
	
	Объект.МаршрутПоездки.Очистить();
	
	Для Счетчик = 0 По ДанныеСоглашения.ГородаПосещения.Количество() - 1 Цикл	
		Объект.МаршрутПоездки.Добавить();
		Объект.МаршрутПоездки[Счетчик].Город = ДанныеСоглашения.ГородаПосещения[Счетчик].Город;
	КонецЦикла; 	
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучитьДанныеСоглашенияНаСервере(Ссылка)
    
    Результат = Новый Структура("Клиент, Страна, Организация, Агент, ГородаПосещения, ЧислоУчастниковПоездки");
    
    Если ЗначениеЗаполнено(Ссылка) Тогда
		
		 Результат.Клиент = Ссылка.Клиент;
		 Результат.Страна = Ссылка.Страна;
		 Результат.Организация = Ссылка.Организация;
		 Результат.Агент = Ссылка.Агент;		 
		 Результат.ЧислоУчастниковПоездки = Ссылка.ЧислоУчастниковПоездки;
		 
		 Результат.ГородаПосещения = Новый Массив();
		 
		 Для Каждого СтрокаТЧ Из Ссылка.ГородаПосещения Цикл
            Результат.ГородаПосещения.Добавить(Новый Структура("Город", СтрокаТЧ.Город));
         КонецЦикла;
		
	КонецЕсли;
		    
    Возврат Результат;
    
КонецФункции  
