&НаКлиенте
Процедура ПереЗаписью(Отказ, ПараметрыЗаписи) 

	Если Объект.ВремяЗаселения > Объект.ВремяВыезда Тогда  
		Отказ = Истина;
		Сообщить("Время выезда не может быть раньше времени заселения!");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)

	ТабДок = ПечатьНаСервере(Объект.Ссылка);
    ТабДок.Показать("Ваучер");

КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере(СсылкаНаДокумент)
	
	ТабДок = Новый ТабличныйДокумент;
    
    Макет = Документы.Ваучер.ПолучитьМакет("ПечатьВаучера");
    
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");        
    ОбластьОсновное    = Макет.ПолучитьОбласть("Основное");
    ОбластьПроживание  = Макет.ПолучитьОбласть("Проживание");
    ОбластьПодвал      = Макет.ПолучитьОбласть("Подвал");  
    
    ТабДок.Вывести(ОбластьШапка); 
    ТабДок.Вывести(ОбластьОсновное);  
    ТабДок.Вывести(ОбластьПроживание); 
    ТабДок.Вывести(ОбластьПодвал);
    
    Возврат ТабДок;        
	
КонецФункции